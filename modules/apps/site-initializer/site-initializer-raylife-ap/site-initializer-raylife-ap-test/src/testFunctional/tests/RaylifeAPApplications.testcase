@component-name = "portal-solutions"
definition {

	property custom.properties = "feature.flag.LPS-165493=true";
	property osgi.modules.includes = "site-initializer-raylife-ap";
	property portal.release = "false";
	property portal.upstream = "true";
	property release.feature.flags.disable.DISABLE_PRIVATE_LAYOUTS = "true";
	property testray.main.component.name = "Site Initializer Raylife AP";

	var testSiteName = "Raylife AP";
	var testSiteURL = "raylife-ap";

	setUp {
		task ("Set up instance and sign in") {
			TestCase.setUpPortalInstance();

			User.firstLoginPG();
		}

		task ("Create a new Raylife AP Site") {
			Site.openSitesAdmin();

			RaylifeAP.addRaylifeAPSite(
				siteName = "${testSiteName}",
				siteTemplateName = "Raylife AP");
		}

		task ("Create a new Raylife D2C Site") {
			Raylife.createRaylifeSite(siteName = "Raylife D2C");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		RaylifeAP.tearDownCP();

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			User.logoutPG();
		}
	}

	@description = "Automtion ID: LPS-157720 | Test Summary: Check that the 'All Applications' button redirects to the 'Applications' page"
	@priority = "4"
	test AllApplicationsRedirectedToApplicationsPage {
		task ("Given I go to Site RaylifeAP") {
			RaylifeAP.goToRaylifeAPSiteWithRefresh();
		}

		task ("When I click in the All Applications I go to Applications Page") {
			RaylifeAP.clickOnAllAplications();
		}

		task ("Then I assert that I was redirected to the application page") {
			RaylifeAP.assertPageHeader(key_header = "Applications");
		}
	}

	@description = "Automtion ID: LPS-157722 | Test Summary: Check if I can delete a recent application on the Kebab button"
	@priority = "4"
	test CanDeleteRecentApplicatios {
		task ("Given I go to Site RaylifeAP") {
			RaylifeAP.goToRaylifeAPSiteWithRefresh();
		}

		task ("Then I click on kebab menu and in the delete option and state that the entry has been deleted") {
			ScrollWebElementIntoView(locator1 = "RaylifeAP#APPLICATIONS_TABLE_KEBAB");

			RaylifeAP.clickInApplicationKebabOption(
				index = "1",
				option = "Delete");

			RaylifeAP.getApplicationNumberAndAssert();
		}
	}

	@description = "Automtion ID: LPS-154587 | Test Summary: Verify that the number in the center of the graph is equal to the total amount of registered products"
	@priority = "4"
	test NumberCenterGraphEqualNumberOfProducts {
		task ("Go to Site RaylifeAP") {
			RaylifeAP.goToRaylifeAPSiteWithRefresh();
		}

		task ("When a click in the Side bar and go to Applications") {
			RaylifeAPNavigator.gotoSidebarItem(itemName = "Applications");
		}

		task ("Then Make a validation of the graph") {
			RaylifeApApplicationsPage.verifyApplicationsValue();
		}
	}

}
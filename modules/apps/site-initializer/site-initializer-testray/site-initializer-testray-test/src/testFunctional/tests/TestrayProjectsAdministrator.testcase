@component-name = "portal-solutions"
definition {

	property osgi.modules.includes = "site-initializer-testray";
	property portal.release = "false";
	property portal.upstream = "true";
	property release.feature.flags.disable.DISABLE_PRIVATE_LAYOUTS = "true";
	property testray.main.component.name = "Site Initializer Testray";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		Testray.tearDownCP();

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
	}

    @description = "This is a test for LPS-160536. Verify if as an Administrator I am able to view a Project"
    @priority = "3"
    test AdminCanViewProject {
        task ("Go to Testray and Create Project") {
			ApplicationsMenu.gotoSite(site = "Testray 2");

            Testray.createProjectTestray(key_name = "ATF_Projects_4 Project");
		}

        task ("stating that I see the project") {
            Testray.goToProjectPage(projectName = "ATF_Projects_4 Project");

            TestrayHeader.assertBreadcrumbTitle(breadcrumbName = "ATF_Projects_4 Project");
        }
    }

}
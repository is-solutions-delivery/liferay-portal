definition {

	macro addNewCategory {
		Click(locator1 = "TestrayManage#ADD_PROJECT_ON_MODAL");

		Type(
			locator1 = "TestrayManage#NEW_OPTION_NAME",
			value1 = "${category}");

		Click(locator1 = "TestrayManage#SAVE_BUTTON");
	}

	macro addNewOptions {
		Click(locator1 = "TestrayManage#ADD_PROJECT_ON_MODAL");

		Type(
			locator1 = "TestrayManage#NEW_OPTION_NAME",
			value1 = "${options}");

		Select(
			locator1 = "TestrayManage#SELECT_CATEGORY",
			value1 = "${category}");

		Click(locator1 = "TestrayManage#SAVE_BUTTON");
	}

	macro assertCategorieNotPresent {
		TestrayManage.selectOptionsManage(itemvalue = "Categories");

		TestrayManage.assertNameNotPresent(name = "${key_title}");
	}

	macro assertName {
		AssertElementPresent(
			key_value = "${name}",
			locator1 = "TestrayManage#OPTIONS_NAME");
	}

	macro assertNameCategoryInOptions {
		AssertElementPresent(
			key_value = "${category}",
			locator1 = "TestrayManage#OPTIONS_NAME");
	}

	macro assertNameNotPresent {
		AssertElementNotPresent(
			locator1 = "TestrayManage#OPTIONS_NAME",
			value = "${name}");
	}

	macro assertOptionNotPresent {
		TestrayManage.selectOptionsManage(itemvalue = "Options");

		TestrayManage.assertNameNotPresent(name = "${key_title}");
	}

	macro assertTitleModal {
		AssertElementNotPresent(
			key_title = "${key_itemvalue}",
			locator1 = "TestrayManage#TITLE_MODAL_ITEM");
	}

	macro closeModalInOptions {
		Click(locator1 = "TestrayManage#CLOSE_MODAL");
	}

	macro createNewCaseTypes {
		Click(locator1 = "TestrayManage#ADD_PROJECT_ON_MODAL");

		Type(
			locator1 = "TestrayManage#NEW_OPTION_NAME",
			value1 = "${caseName}");

		Click(locator1 = "TestrayManage#SAVE_BUTTON");
	}

	macro createNewOption {
		Click(locator1 = "TestrayManage#ADD_PROJECT_ON_MODAL");

		Type(
			locator1 = "TestrayManage#NEW_OPTION_NAME",
			value1 = "${key_value}");

		Select(
			key_value = "${categorie}",
			locator1 = "TestrayManage#OPTIONS_CATEGORIES");

		Click(locator1 = "TestrayManage#SAVE_BUTTON");
	}

	macro deleteCategory {
		TestrayManage.selectOptionsManage(itemvalue = "Categories");

		TestrayManage.selectOptionDropdownCategory(
			key_title = "${categorie}",
			menuItem = "${menuItem}");

		Alert.viewSuccessMessage();
	}

	macro deleteOption {
		TestrayManage.selectOptionsManage(itemvalue = "Options");

		TestrayManage.selectOptionDropdownCategory(
			key_title = "${categorie}",
			menuItem = "${menuItem}");

		Alert.viewSuccessMessage();
	}

	macro deleteProject {
		MouseOver(
			key_value = "${valueName}",
			locator1 = "TestrayManage#OPTIONS_NAME");

		Click(locator1 = "TestrayDropdown#DROPDOWN_ITEM");

		MenuItem.clickNoError(menuItem = "Delete");
	}

	macro editCategoryOption {
		Type(
			locator1 = "TestrayManage#OPTIONS_CATEGORIES",
			value1 = "${category}");

		Click(locator1 = "TestrayManage#SAVE_BUTTON");
	}

	macro editNameCategory {
		Type(
			locator1 = "TestrayManage#NEW_OPTION_NAME",
			value1 = "${category}");

		Click(locator1 = "TestrayManage#SAVE_BUTTON");
	}

	macro editNewName {
		TestrayManage.goToEditPage(valueName = "${valueName}");

		Type(
			locator1 = "TestrayManage#NEW_OPTION_NAME",
			value1 = "${valueType}");

		Click(locator1 = "TestrayManage#SAVE_BUTTON");
	}

	macro editNewOptionName {
		TestrayManage.goToEditPage(valueName = "${valueName}");

		Type(
			locator1 = "TestrayManage#NEW_OPTION_NAME",
			value1 = "${valueType}");

		Select(
			locator1 = "TestrayManage#SELECT_CATEGORY",
			value1 = "${category}");

		Click(locator1 = "TestrayManage#SAVE_BUTTON");
	}

	macro goToEditPage {
		MouseOver(
			key_value = "${valueName}",
			locator1 = "TestrayManage#OPTIONS_NAME");

		Click(locator1 = "TestrayDropdown#DROPDOWN_ITEM");

		MenuItem.clickNoError(menuItem = "Edit");
	}

	macro selectOption {
		Select(locator1 = "TestrayManage#OPTIONS_NAME");
	}

	macro selectOptionDropdownCategory {
		Click(locator1 = "TestrayManage#DROPDOWN_CATEGORIES");

		MenuItem.clickNoError(menuItem = "${menuItem}");

		Alert.viewSuccessMessage();
	}

	macro selectOptionsManage {
		Click(
			key_itemvalue = "${itemvalue}",
			locator1 = "TestrayDropdown#OPTIONS_SIDEBAR");
	}

}
@component-name = "portal-solutions"
definition {

	property osgi.modules.includes = "osb-site-initializer-customer-portal";
	property portal.release = "false";
	property portal.upstream = "true";
	property release.feature.flags.disable.DISABLE_PRIVATE_LAYOUTS = "true";
	property testray.main.component.name = "OSB Site Initializer Customer Portal";

	var testSiteName = "Customer Portal Site";
	var testSiteURL = "customer-portal-site";
	var testAccount = "NASA ICE";

	setUp {
		task ("Set up instance and sign in") {
			TestCase.setUpPortalInstance();

			User.firstLoginPG();
		}

		task ("Create a new Customer Portal Site") {
			CustomerPortal.addCustomerPortalSite(siteName = "${testSiteName}");
		}

		task ("Add test user access to all Accounts") {
			CustomerPortal.assignUserToOrganization();

			CustomerPortal.addUserToOneOrMoreAccounts(accountsList = "${testAccount}");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		CustomerPortal.customerPortalApisTearDown();

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			JSONGroup.deleteGroupByName(groupName = "${testSiteName}");
		}
	}

	@description = "Automation ID: LPS-151354 | Test Summary: Verify if Clear Filters button works."
	@ignore = "true"
	@priority = "2"
	test VerifyClearFiltersButtonWorks {

		// Needs refactor since it depends on real projects Portals account

		task ("Select a project") {
			ApplicationsMenu.gotoSite(key_site = "${testSiteName}");

			CustomerPortal.search(searchItem = "NASA ICE");

			CustomerPortal.enterOnProject(title = "NASA ICE");
		}

		task ("Go to Product Activation and Product page") {
			CP2NavigationMenu.goToProductActivation();

			CP2NavigationMenu.clickOnProductButton(product = "Portal");
		}

		task ("Click on Filter and Select a Filter type") {
			CustomerPortal.clickAtButton(text = "Filter");

			CustomerPortal.clickAtButton(text = "Key Type");

			Click.clickNoWaitForVisible(
				key_checkbox = "On-Premise",
				key_menu = "Key Type",
				locator1 = "CP2NavigationMenu#FILTER_CHECKBOX");
		}

		task ("Then Click on Apply and Assert if the filter is enable") {
			CustomerPortal.clickAtButton(text = "Apply");

			AssertElementPresent(
				locator1 = "CP2NavigationMenu#FILTER_RESULT",
				result = "On-Premise");
		}

		task ("Then Click on Clear All Filters and Assert if the filter is disabled") {
			CustomerPortal.clickAtButton(text = "Clear All Filters");

			AssertElementNotPresent(
				locator1 = "CP2NavigationMenu#FILTER_RESULT",
				result = "On-Premise");
		}
	}

	@description = "Automation ID: LPS-151351 | Test Summary: Verify that the Environment Type has the options according to the project keys."
	@ignore = "true"
	@priority = "2"
	test VerifyFilterEnvironmentTypeOptionsArePresent {

		// Needs refactor since it depends on real projects Portals account

		task ("Signs in OKTA to update and go to Customer Portal") {
			CustomerPortal.loginOktaToUpdateCP();

			Navigator.openURL();

			ApplicationsMenu.gotoSite(key_site = "${testSiteName}");
		}

		task ("Select a project") {
			ApplicationsMenu.gotoSite(key_site = "${testSiteName}");

			CustomerPortal.search(searchItem = "NASA ICE");

			CustomerPortal.enterOnProject(title = "NASA ICE");
		}

		task ("Go to Product Activation and Product page") {
			CP2NavigationMenu.goToProductActivation();

			CP2NavigationMenu.clickOnProductButton(product = "Portal");
		}

		task ("Click on Filter and Select a Filter type") {
			CustomerPortal.clickAtButton(text = "Filter");

			CustomerPortal.clickAtButton(text = "Environment Type");

			Click.clickAt(
				filter = "Production",
				index = "1",
				locator1 = "CP2NavigationMenu#FILTER_CHECKBOX");
		}

		task ("Then Click on Apply and Assert if the filter is enable") {
			Click.clickAt(
				index = "3",
				locator1 = "CP2NavigationMenu#FILTER_APPLY");

			Click(
				key_text = "Redacted",
				locator1 = "CP2ActivationKeys#RESPONSIVE_TABLE");

			CP2ActivationKeys.assertKeyDetailsEnvironmentElements(environmentType = "Production");

			AssertElementPresent(
				locator1 = "CP2NavigationMenu#FILTER_RESULT",
				result = "Production");
		}
	}

	@description = "Automation ID: LPS-151346 | Test Summary: Verify if the filter Instance Size option displays a list 1 or more, depends on project"
	@ignore = "true"
	@priority = "3"
	test VerifyFilterListOnInstanceSizeIsPresent {

		// Needs refactor since it depends on real projects Portals account

		task ("Signs in OKTA to update and go to Customer Portal") {
			CustomerPortal.loginOktaToUpdateCP();

			Navigator.openURL();

			ApplicationsMenu.gotoSite(key_site = "${testSiteName}");
		}

		task ("Select a project and go to activation page") {
			CustomerPortal.enterOnProject(title = "NASA ICE");

			CP2NavigationMenu.goToProductActivation();

			CP2NavigationMenu.clickOnProductButton(product = "Portal");
		}

		task ("Then a user click and select a filter option ") {
			CustomerPortal.clickAtButton(text = "Filter");

			CustomerPortal.clickAtButton(text = "Instance Size");

			Click.clickAt(
				filter = "1",
				index = "3",
				locator1 = "CP2NavigationMenu#FILTER_CHECKBOX");
		}

		task ("Assert if the list reflect the filter") {
			AssertElementPresent(
				filter = "1",
				index = "3",
				locator1 = "CP2NavigationMenu#FILTER_CHECKBOX");

			Click(
				key_text = "Redacted",
				locator1 = "CP2ActivationKeys#RESPONSIVE_TABLE");

			CP2ActivationKeys.assertKeyDetailsEnvironmentElements(instanceSize = "2");

			CustomerPortal.clickAtButton(text = "Close");
		}
	}

	@description = "Automation ID: LPS-151353 | Test Summary: Verify if the user can type a date in 'On or after' field on Expiration Date."
	@ignore = "true"
	@priority = "4"
	test VerifyFilterOnExpirationDateWorks {

		// Needs refactor since it depends on real projects Portals account

		task ("Signs in OKTA to update and go to Customer Portal") {
			CustomerPortal.loginOktaToUpdateCP();

			Navigator.openURL();

			ApplicationsMenu.gotoSite(key_site = "${testSiteName}");
		}

		task ("Select a project") {
			ApplicationsMenu.gotoSite(key_site = "${testSiteName}");

			CustomerPortal.search(searchItem = "NASA ICE");

			CustomerPortal.enterOnProject(title = "NASA ICE");
		}

		task ("Go to Product Activation and Product page") {
			CP2NavigationMenu.goToProductActivation();

			CP2NavigationMenu.clickOnProductButton(product = "Portal");
		}

		task ("Click on Filter and Select a Filter type") {
			CustomerPortal.clickAtButton(text = "Filter");

			CustomerPortal.clickAtButton(text = "Expiration Date");
		}

		task ("Click Start Date and fill in the field and assert the results of the label") {
			CP2NavigationMenu.typeDate(
				data = "jun 29 2023",
				field = "On or After",
				index = "5",
				index1 = "2");

			Click(
				key_text = "Redacted",
				locator1 = "CP2ActivationKeys#RESPONSIVE_TABLE");

			CP2ActivationKeys.assertKeyDetailsStatusElements(expirationDate = "Jun 29, 2023");
		}
	}

	@description = "Automation ID: LPS-151352 | Test Summary: Verify if the user can type a date in 'On or after' field on Start Date."
	@ignore = "true"
	@priority = "4"
	test VerifyFilterOnStartDateWorks {

		// Needs refactor since it depends on real projects Portals account

		task ("Signs in OKTA to update and go to Customer Portal") {
			CustomerPortal.loginOktaToUpdateCP();

			Navigator.openURL();

			ApplicationsMenu.gotoSite(key_site = "${testSiteName}");
		}

		task ("Select a project") {
			ApplicationsMenu.gotoSite(key_site = "${testSiteName}");

			CustomerPortal.search(searchItem = "NASA ICE");

			CustomerPortal.enterOnProject(title = "NASA ICE");
		}

		task ("Go to Product Activation and Product page") {
			CP2NavigationMenu.goToProductActivation();

			CP2NavigationMenu.clickOnProductButton(product = "Portal");
		}

		task ("Click on Filter and Select a Filter type") {
			CustomerPortal.clickAtButton(text = "Filter");

			WaitForVisible(
				key_text = "Start Date",
				locator1 = "CustomerPortalSite#ANY_BUTTON");

			CustomerPortal.clickAtButton(text = "Start Date");
		}

		task ("Click Start Date and fill in the field and assert the results of the label") {
			CP2NavigationMenu.typeDate(
				data = "Jun 7 2022",
				field = "On or After",
				index = "4",
				index1 = "1");

			Click(
				key_text = "Redacted",
				locator1 = "CP2ActivationKeys#RESPONSIVE_TABLE");

			CP2ActivationKeys.assertKeyDetailsStatusElements(startDate = "Jun 7, 2022");
		}
	}

	@description = "Automation ID: LPS-151350 | Test Summary: Verify if after the user click on the Apply button, the list of activation keys matches the selected criteria."
	@ignore = "true"
	test VerifyPortalActivationApplyButton {

		// Needs refactor since it depends on real projects Portals account

		task ("Signs in OKTA to update and go to Customer Portal") {
			CustomerPortal.loginOktaToUpdateCP();

			Navigator.openURL();

			ApplicationsMenu.gotoSite(key_site = "${testSiteName}");
		}

		task ("Select a project") {
			ApplicationsMenu.gotoSite(key_site = "${testSiteName}");

			CustomerPortal.search(searchItem = "NASA ICE");

			CustomerPortal.enterOnProject(title = "NASA ICE");
		}

		task ("Go to Product Activation and Product page") {
			CP2NavigationMenu.goToProductActivation();

			CP2NavigationMenu.clickOnProductButton(product = "Portal");
		}

		task ("Click on Filter and Select a Filter type") {
			CustomerPortal.clickAtButton(text = "Filter");

			CustomerPortal.clickAtButton(text = "Key Type");

			Click.clickAt(
				filter = "On-Premise",
				index = "1",
				locator1 = "CP2NavigationMenu#FILTER_CHECKBOX");
		}

		task ("Assert if the list reflect the filter") {
			CustomerPortal.clickAtButton(text = "Apply");

			AssertElementPresent(
				locator1 = "CP2NavigationMenu#FILTER_RESULT",
				result = "On-Premise");

			Click(
				key_text = "Redacted",
				locator1 = "CP2ActivationKeys#RESPONSIVE_TABLE");

			CP2ActivationKeys.assertKeyDetailsServerElements(keyType = "On-Premise");
		}
	}

	@description = "Automation ID: LPS-151348 | Test Summary: Verify if the user can search a IP Addresses."
	@ignore = "true"
	@priority = "3"
	test VerifyUserCanSearchIPAddresses {

		// Needs refactor since it depends on real projects Portals account

		task ("Signs in OKTA to update and go to Customer Portal") {
			CustomerPortal.loginOktaToUpdateCP();

			Navigator.openURL();

			ApplicationsMenu.gotoSite(key_site = "${testSiteName}");
		}

		task ("Select a project and go to activation page") {
			CustomerPortal.enterOnProject(title = "NASA ICE");

			CP2NavigationMenu.goToProductActivation();

			CP2NavigationMenu.clickOnProductButton(product = "Portal");
		}

		task ("Search for a IP Addresses and assert the search") {
			Click(locator1 = "CP2NavigationMenu#SEARCH_FILTER");

			Type(
				locator1 = "CP2NavigationMenu#SEARCH_FILTER",
				value1 = "192.168.0.111");

			KeyPress(
				locator1 = "CP2NavigationMenu#SEARCH_FILTER",
				value1 = "\ENTER");

			AssertElementPresent(locator1 = "CP2NavigationMenu#SEARCH_RESULT");

			Click(
				key_text = "teste",
				locator1 = "CP2ActivationKeys#RESPONSIVE_TABLE");

			CP2ActivationKeys.assertKeyDetailsServerElements(ipAddress = "192.168.0.111");
		}
	}

}
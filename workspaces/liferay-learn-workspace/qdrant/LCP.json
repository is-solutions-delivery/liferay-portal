{
  "kind": "Deployment",
  "id": "qdrant",
  "image": "qdrant/qdrant:v1.9.2",
  "memory": 1024,
  "cpu": 1,
  "scale": 1,
  "ports": [
    {
      "port": 6333,
      "external": false
    },
    {
      "port": 6334,
      "external": false
    }
  ],
  "readinessProbe": {
    "httpGet": {
      "path": "/",
      "port": 6333
    },
    "initialDelaySeconds": 30,
    "periodSeconds": 60,
    "timeoutSeconds": 10,
    "failureThreshold": 2
  },
  "livenessProbe": {
    "httpGet": {
      "path": "/",
      "port": 6333
    },
    "initialDelaySeconds": 600,
    "periodSeconds": 60,
    "timeoutSeconds": 60,
    "failureThreshold": 3
  },
  "environments": {
    "infra": {
      "deploy": false
    }
  },
  "volumes": {
    "homeLiferay": "/home/liferay",
    "data": "/qdrant/storage"
  }
}